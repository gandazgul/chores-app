---
import ChoreList from "../components/ChoreList.tsx";
import { ChoreModal } from "../components/ChoreModal.tsx";
import Layout from "../layouts/Layout.astro";
import type { Chore, ChoreRow } from "../types.ts";
import { parseChoreRows } from "../types.ts";
import db from "../utils/db.ts";

const user = Astro.locals.user;

let chores: Chore[] = [];
if (user) {
  const stmt = db.prepare(
    "SELECT * FROM chores WHERE user_id = ? ORDER BY due_date",
  );
  chores = parseChoreRows(stmt.all(user.id) as unknown as ChoreRow[]);
}
---

<Layout>
  <div class="w-full">
    <header
      class="bg-[#e6f3f5] border-b border-[#c7e3e8] shadow-sm p-4 flex items-center justify-between gap-4"
    >
      <div>
        <h1 class="text-2xl font-bold text-primary-text leading-tight">Tow</h1>
        <p class="text-primary text-sm tracking-wide font-semibold">
          STEADY HOUSEHOLD MANAGEMENT
        </p>
      </div>
      {user && <ChoreModal client:load />}
    </header>

    <main class="bg-white border-b border-gray-200 w-full">
      {!user ? (
        <div class="p-8 text-center text-muted-text">
          <p>Please log in to view your chores.</p>
        </div>
      ) : (
        <ChoreList client:load initialChores={chores} />
      )}
    </main>
  </div>
</Layout>
