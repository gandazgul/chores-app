---
import ChoreManager from "../components/ChoreManager.tsx";
import Layout from "../layouts/Layout.astro";
import type { Chore, ChoreRow, Member } from "../types.ts";
import { parseChoreRows } from "../types.ts";
import db from "../utils/db.ts";
import { resolveHouseholdTimeZone } from "../utils/householdTime.ts";

const user = Astro.locals.user;
const householdTimeZone = resolveHouseholdTimeZone(Deno.env.get("HOUSEHOLD_TZ"));

let chores: Chore[] = [];
let members: Member[] = [];
if (user) {
  const choreStmt = db.prepare(
    "SELECT * FROM chores WHERE status IN ('open', 'completed') ORDER BY due_date",
  );
  chores = parseChoreRows(choreStmt.all() as unknown as ChoreRow[]);

  const memberStmt = db.prepare(
    "SELECT id, name, picture FROM users ORDER BY name COLLATE NOCASE, email COLLATE NOCASE",
  );
  members = memberStmt.all() as unknown as Member[];
}
---

<Layout>
  {
    !user ? (
      <div class="w-full flex-1 flex flex-col">
        <header class="bg-[#e6f3f5] border-b border-[#c7e3e8] shadow-sm p-4 flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <img src="/icon.png" alt="Tow logo" class="w-8 h-8 rounded-lg shadow-sm" />
            <div>
              <h1 class="text-2xl font-bold text-primary-text leading-tight">Tow</h1>
              <p class="text-primary text-sm tracking-wide font-semibold">
                STEADY HOUSEHOLD MANAGEMENT
              </p>
            </div>
          </div>
        </header>
        <div class="bg-white border-b border-gray-200 w-full flex-1 flex flex-col">
          <div class="p-8 text-center text-muted-text">
            <p>Please log in to view your chores.</p>
          </div>
        </div>
      </div>
    ) : (
      <ChoreManager
        client:load
        initialChores={chores}
        members={members}
        currentMemberId={user.id}
        householdTimeZone={householdTimeZone}
      />
    )
  }
</Layout>
