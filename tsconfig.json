{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "tests",
    "scripts",
    "playwright.config.ts",
    "src/**/*.test.ts"
  ],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": [
      "deno",
      "node"
    ]
  }
}
