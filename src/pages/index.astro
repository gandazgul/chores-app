---
import Layout from '../layouts/Layout.astro';
import db from '../utils/db.js';
import ChoreList from '../components/ChoreList.jsx';
import { ChoreModal } from '../components/ChoreModal.jsx';

const user = Astro.locals.user;

let chores = [];
if (user) {
  const stmt = db.prepare('SELECT * FROM chores WHERE user_id = ? ORDER BY due_date');
  chores = stmt.all(user.id).map((chore) => {
    try {
      if (chore && typeof chore.recurrence === "string") {
        chore.recurrence = JSON.parse(chore.recurrence);
      }
    } catch (_e) {
      // ignore
    }
    return chore;
  });
}
---

<Layout>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <header class="flex justify-between items-center mb-8">
      <div>
        <h1 class="text-3xl font-bold text-primary-text mb-1">My Chores</h1>
        <p class="text-muted-text">Manage your daily and weekly tasks</p>
      </div>
      {user && <ChoreModal client:load />}
    </header>
    
    <main class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden h-[600px]">
      {!user ? (
        <div class="p-8 text-center text-muted-text">
          <p>Please log in to view your chores.</p>
        </div>
      ) : (
        <ChoreList client:load initialChores={chores} />
      )}
    </main>
  </div>
</Layout>
