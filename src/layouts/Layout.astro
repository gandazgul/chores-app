---
import '@unocss/reset/tailwind.css';
import 'uno.css';
---

<!DOCTYPE html>
<html lang="en" class="w-full h-full bg-primary-bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tow</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#005f6a" />
    <meta name="description" content="Steady household management for recurring chores." />
    <style is:global>
      /* Island wrappers must not add layout boxes between the shell rows. */
      astro-island {
        display: contents;
      }
    </style>
  </head>
  <body class="bg-primary-bg text-primary-text font-sans w-full h-full min-w-[20rem] flex flex-col overflow-hidden">
    <main class="w-full max-w-none flex-1 min-h-0 flex flex-col items-stretch">
      <slot />
    </main>

    <footer class="w-full max-w-none h-14 shrink-0 flex items-center justify-center text-center text-muted-text">
      <p>&copy; {new Date().getFullYear()} Tow</p>
    </footer>
  </body>
</html>
