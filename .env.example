# Required HTTPS origin for production authentication, e.g. https://todo.dumbhome.uk.
# Leave unset for direct local development. Forwarded headers are not trusted.
PUBLIC_ORIGIN=
DB_ENV=development
# Container default: /data/chores.db. Mount the entire /data directory.
# DB_PATH=/data/chores.db

GOOGLE_CLIENT_ID=your_client_id_here

# Set to false to bypass Google Authentication and use the Mock User. Use only for local development and tests.
ENABLE_AUTH=false
COOKIE_SECURE=false
SESSION_SECRET=your_session_secret_here

# Required when authentication is enabled. Comma-separated and case-insensitive.
# Missing or empty ALLOWED_EMAILS denies all real Google accounts.
ALLOWED_EMAILS=member.one@example.com,member.two@example.com

# Optional IANA timezone for household Due Date buckets and display.
# Defaults to UTC when absent. Invalid values stop startup clearly.
HOUSEHOLD_TZ=America/New_York

# Optional scheduler and Push Notification controls.
# ENABLE_NOTIFICATIONS defaults to true. Set false to stop the scheduler,
# Delivery Slot creation, and sends. Invalid values stop startup clearly.
ENABLE_NOTIFICATIONS=true
QUIET_HOURS_START=21:00
QUIET_HOURS_END=08:00

# Optional Pool Blast lead time, in whole hours before the Due Date.
# Unset, blank, or 0 disables Pool Blast. A positive whole number enables one
# Pool Blast per Chore and Member. Invalid values stop startup clearly.
POOL_BLAST_LEAD_HOURS=0

# Optional Gotify server URL for Push Notifications.
# HTTPS is required by default. Plain HTTP is allowed for localhost, 127.0.0.1, and [::1].
# For a trusted local-area network only, set ALLOW_INSECURE_GOTIFY=true to allow remote HTTP.
# That override sends bearer tokens without transport encryption. Do not enable it by default.
GOTIFY_URL=https://gotify.example.com
ALLOW_INSECURE_GOTIFY=false
